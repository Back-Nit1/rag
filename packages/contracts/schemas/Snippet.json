{
  "$id": "https://metis.local/schemas/v1/Snippet.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Spoken trigger phrase that is replaced verbatim by ``expansion``.",
  "properties": {
    "expansion": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Expansion",
      "type": "string"
    },
    "trigger": {
      "maxLength": 64,
      "minLength": 2,
      "title": "Trigger",
      "type": "string"
    }
  },
  "required": [
    "trigger",
    "expansion"
  ],
  "title": "Snippet",
  "type": "object",
  "x-contract-version": 1
}
