{
  "$id": "https://metis.local/schemas/v1/ClarificationRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "At most one active thread per captured item, with batched fields.",
  "properties": {
    "blocking": {
      "default": false,
      "title": "Blocking",
      "type": "boolean"
    },
    "clarification_id": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Clarification Id",
      "type": "string"
    },
    "missing_fields": {
      "items": {
        "type": "string"
      },
      "title": "Missing Fields",
      "type": "array"
    },
    "question": {
      "maxLength": 500,
      "title": "Question",
      "type": "string"
    },
    "source_id": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Source Id",
      "type": "string"
    },
    "target_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Id"
    }
  },
  "required": [
    "clarification_id",
    "source_id",
    "question",
    "missing_fields"
  ],
  "title": "ClarificationRequest",
  "type": "object",
  "x-contract-version": 1
}
