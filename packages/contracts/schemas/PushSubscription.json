{
  "$id": "https://metis.local/schemas/v1/PushSubscription.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "auth": {
      "title": "Auth",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "disabled_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Disabled At"
    },
    "endpoint": {
      "maxLength": 2000,
      "minLength": 10,
      "title": "Endpoint",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Id",
      "type": "string"
    },
    "p256dh": {
      "title": "P256Dh",
      "type": "string"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "user_agent": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "User Agent"
    },
    "user_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "User Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "user_id",
    "created_at",
    "updated_at",
    "endpoint",
    "p256dh",
    "auth"
  ],
  "title": "PushSubscription",
  "type": "object",
  "x-contract-version": 1
}
