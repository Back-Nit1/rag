{
  "$defs": {
    "StatusUpdateAction": {
      "enum": [
        "registered",
        "canceled"
      ],
      "title": "StatusUpdateAction",
      "type": "string"
    }
  },
  "$id": "https://metis.local/schemas/v1/TargetChoice.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An ambiguous status update awaiting an explicit target.\n\nRecorded when a resolved proposal's status_update item had no single target.\n``chosen_id`` stays null until the user picks one of ``candidate_ids``; the\nserver never picks and never matches by title.",
  "properties": {
    "candidate_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "type": "string"
      },
      "title": "Candidate Ids",
      "type": "array"
    },
    "chosen_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chosen Id"
    },
    "item_index": {
      "minimum": 0,
      "title": "Item Index",
      "type": "integer"
    },
    "update_action": {
      "$ref": "#/$defs/StatusUpdateAction"
    }
  },
  "required": [
    "item_index",
    "update_action"
  ],
  "title": "TargetChoice",
  "type": "object",
  "x-contract-version": 1
}
