{
  "$defs": {
    "TimeWindow": {
      "additionalProperties": false,
      "description": "Local wall-clock window, e.g. 09:00-17:00. Not an instant.",
      "properties": {
        "end": {
          "pattern": "^\\d{2}:\\d{2}$",
          "title": "End",
          "type": "string"
        },
        "start": {
          "pattern": "^\\d{2}:\\d{2}$",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeWindow",
      "type": "object"
    }
  },
  "$id": "https://metis.local/schemas/v1/AvailabilityBlock.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Manually captured fixed block. No external calendar provider required.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "available",
        "busy"
      ],
      "title": "Kind",
      "type": "string"
    },
    "label": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Label"
    },
    "local_date": {
      "format": "date",
      "title": "Local Date",
      "type": "string"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "timezone": {
      "examples": [
        "America/New_York"
      ],
      "maxLength": 64,
      "minLength": 1,
      "title": "Timezone",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "user_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "User Id",
      "type": "string"
    },
    "window": {
      "$ref": "#/$defs/TimeWindow"
    }
  },
  "required": [
    "id",
    "user_id",
    "created_at",
    "updated_at",
    "local_date",
    "timezone",
    "window",
    "kind"
  ],
  "title": "AvailabilityBlock",
  "type": "object",
  "x-contract-version": 1
}
