{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "description": "One retrieved, source-backed justification shown to the user.",
      "properties": {
        "excerpt": {
          "maxLength": 2000,
          "title": "Excerpt",
          "type": "string"
        },
        "memory_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Id"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "source_id": {
          "maxLength": 128,
          "minLength": 3,
          "title": "Source Id",
          "type": "string"
        },
        "source_version": {
          "minimum": 1,
          "title": "Source Version",
          "type": "integer"
        },
        "span_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Ref"
        },
        "validity": {
          "default": "current",
          "enum": [
            "current",
            "historical",
            "superseded",
            "uncertain"
          ],
          "title": "Validity",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_version",
        "excerpt",
        "recorded_at"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "MemoryKind": {
      "enum": [
        "idea",
        "observation",
        "hypothesis",
        "decision",
        "commitment",
        "work_log",
        "attempt",
        "blocker",
        "preference"
      ],
      "title": "MemoryKind",
      "type": "string"
    },
    "SearchResult": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "kind": {
          "$ref": "#/$defs/MemoryKind"
        },
        "memory_id": {
          "maxLength": 128,
          "minLength": 3,
          "title": "Memory Id",
          "type": "string"
        },
        "project_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "score": {
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "memory_id",
        "kind",
        "content",
        "score",
        "evidence"
      ],
      "title": "SearchResult",
      "type": "object"
    }
  },
  "$id": "https://metis.local/schemas/v1/SearchResponse.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "degraded_reason": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Degraded Reason"
    },
    "index_available": {
      "default": true,
      "title": "Index Available",
      "type": "boolean"
    },
    "index_stale": {
      "default": false,
      "title": "Index Stale",
      "type": "boolean"
    },
    "mode_used": {
      "title": "Mode Used",
      "type": "string"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/SearchResult"
      },
      "title": "Results",
      "type": "array"
    }
  },
  "required": [
    "mode_used"
  ],
  "title": "SearchResponse",
  "type": "object",
  "x-contract-version": 1
}
