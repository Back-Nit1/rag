{
  "$id": "https://metis.local/schemas/v1/Budgets.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Enforced before paid calls, not merely displayed afterwards.",
  "properties": {
    "allow_escalation_model": {
      "default": false,
      "title": "Allow Escalation Model",
      "type": "boolean"
    },
    "daily_micro_usd": {
      "default": 500000,
      "minimum": 0,
      "title": "Daily Micro Usd",
      "type": "integer"
    },
    "max_audio_seconds": {
      "default": 300,
      "maximum": 3600,
      "minimum": 1,
      "title": "Max Audio Seconds",
      "type": "integer"
    },
    "max_extraction_input_tokens": {
      "default": 4000,
      "minimum": 256,
      "title": "Max Extraction Input Tokens",
      "type": "integer"
    },
    "max_extraction_output_tokens": {
      "default": 1200,
      "minimum": 128,
      "title": "Max Extraction Output Tokens",
      "type": "integer"
    },
    "max_planning_input_tokens": {
      "default": 8000,
      "minimum": 512,
      "title": "Max Planning Input Tokens",
      "type": "integer"
    },
    "max_planning_output_tokens": {
      "default": 2000,
      "minimum": 128,
      "title": "Max Planning Output Tokens",
      "type": "integer"
    },
    "max_speech_concurrency": {
      "default": 1,
      "maximum": 8,
      "minimum": 1,
      "title": "Max Speech Concurrency",
      "type": "integer"
    },
    "max_tool_iterations": {
      "default": 4,
      "maximum": 8,
      "minimum": 1,
      "title": "Max Tool Iterations",
      "type": "integer"
    },
    "max_upload_bytes": {
      "default": 26214400,
      "minimum": 1024,
      "title": "Max Upload Bytes",
      "type": "integer"
    },
    "monthly_micro_usd": {
      "default": 10000000,
      "minimum": 0,
      "title": "Monthly Micro Usd",
      "type": "integer"
    }
  },
  "title": "Budgets",
  "type": "object",
  "x-contract-version": 1
}
