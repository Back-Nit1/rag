{
  "$defs": {
    "DictionaryEntry": {
      "additionalProperties": false,
      "description": "Preferred spelling plus the spoken/misheard forms that map to it.",
      "properties": {
        "aliases": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Aliases",
          "type": "array"
        },
        "term": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Term",
          "type": "string"
        }
      },
      "required": [
        "term"
      ],
      "title": "DictionaryEntry",
      "type": "object"
    },
    "Snippet": {
      "additionalProperties": false,
      "description": "Spoken trigger phrase that is replaced verbatim by ``expansion``.",
      "properties": {
        "expansion": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Expansion",
          "type": "string"
        },
        "trigger": {
          "maxLength": 64,
          "minLength": 2,
          "title": "Trigger",
          "type": "string"
        }
      },
      "required": [
        "trigger",
        "expansion"
      ],
      "title": "Snippet",
      "type": "object"
    }
  },
  "$id": "https://metis.local/schemas/v1/FlowSettings.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Dictation (\"Flow\") behaviour. Cleanup is deterministic: no model call,\nso dictation has no spend path.",
  "properties": {
    "app_styles": {
      "additionalProperties": {
        "enum": [
          "standard",
          "casual",
          "literal"
        ],
        "type": "string"
      },
      "maxProperties": 50,
      "title": "App Styles",
      "type": "object"
    },
    "dictionary": {
      "items": {
        "$ref": "#/$defs/DictionaryEntry"
      },
      "maxItems": 200,
      "title": "Dictionary",
      "type": "array"
    },
    "keep_history": {
      "default": false,
      "title": "Keep History",
      "type": "boolean"
    },
    "remove_fillers": {
      "default": true,
      "title": "Remove Fillers",
      "type": "boolean"
    },
    "snippets": {
      "items": {
        "$ref": "#/$defs/Snippet"
      },
      "maxItems": 100,
      "title": "Snippets",
      "type": "array"
    }
  },
  "title": "FlowSettings",
  "type": "object",
  "x-contract-version": 1
}
