{
  "$defs": {
    "AttendanceStatus": {
      "enum": [
        "tentative",
        "committed",
        "declined",
        "canceled"
      ],
      "title": "AttendanceStatus",
      "type": "string"
    },
    "RegistrationStatus": {
      "description": "Never inferred from an intention to attend.",
      "enum": [
        "unknown",
        "not_registered",
        "registered"
      ],
      "title": "RegistrationStatus",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "Pointer to an immutable source revision, optionally a span within it.",
      "properties": {
        "source_id": {
          "maxLength": 128,
          "minLength": 3,
          "title": "Source Id",
          "type": "string"
        },
        "source_version": {
          "minimum": 1,
          "title": "Source Version",
          "type": "integer"
        },
        "span_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Ref"
        }
      },
      "required": [
        "source_id",
        "source_version"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "$id": "https://metis.local/schemas/v1/Event.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attendance_status": {
      "$ref": "#/$defs/AttendanceStatus",
      "default": "tentative"
    },
    "body": {
      "anyOf": [
        {
          "maxLength": 20000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Body"
    },
    "canceled_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Canceled At"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "ends_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ends At"
    },
    "external_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "External Ref"
    },
    "id": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Id",
      "type": "string"
    },
    "local_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Local Date"
    },
    "location_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Location Text"
    },
    "meeting_link": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Meeting Link"
    },
    "project_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "registration_deadline_local_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Registration Deadline Local Date"
    },
    "registration_status": {
      "$ref": "#/$defs/RegistrationStatus",
      "default": "unknown"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_refs": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "title": "Source Refs",
      "type": "array"
    },
    "starts_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Starts At"
    },
    "timezone": {
      "anyOf": [
        {
          "examples": [
            "America/New_York"
          ],
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Timezone"
    },
    "title": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "user_edited_fields": {
      "items": {
        "type": "string"
      },
      "title": "User Edited Fields",
      "type": "array"
    },
    "user_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "User Id",
      "type": "string"
    },
    "venue_address": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Venue Address"
    }
  },
  "required": [
    "id",
    "user_id",
    "created_at",
    "updated_at",
    "title"
  ],
  "title": "Event",
  "type": "object",
  "x-contract-version": 1
}
