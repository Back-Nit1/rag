{
  "$defs": {
    "MemoryKind": {
      "enum": [
        "idea",
        "observation",
        "hypothesis",
        "decision",
        "commitment",
        "work_log",
        "attempt",
        "blocker",
        "preference"
      ],
      "title": "MemoryKind",
      "type": "string"
    },
    "MemoryValidity": {
      "enum": [
        "current",
        "superseded",
        "uncertain"
      ],
      "title": "MemoryValidity",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "Pointer to an immutable source revision, optionally a span within it.",
      "properties": {
        "source_id": {
          "maxLength": 128,
          "minLength": 3,
          "title": "Source Id",
          "type": "string"
        },
        "source_version": {
          "minimum": 1,
          "title": "Source Version",
          "type": "integer"
        },
        "span_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Ref"
        }
      },
      "required": [
        "source_id",
        "source_version"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "$id": "https://metis.local/schemas/v1/Memory.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Searchable, source-backed context. Never authoritative for task status.",
  "properties": {
    "content": {
      "maxLength": 8000,
      "title": "Content",
      "type": "string"
    },
    "content_hash": {
      "maxLength": 64,
      "minLength": 64,
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "effective_at": {
      "format": "date-time",
      "title": "Effective At",
      "type": "string"
    },
    "embedding_dimensions": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Embedding Dimensions"
    },
    "embedding_model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Embedding Model Id"
    },
    "entity_refs": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "type": "string"
      },
      "title": "Entity Refs",
      "type": "array"
    },
    "id": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Id",
      "type": "string"
    },
    "indexed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Indexed At"
    },
    "indexed_source_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Indexed Source Version"
    },
    "kind": {
      "$ref": "#/$defs/MemoryKind"
    },
    "project_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_refs": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "title": "Source Refs",
      "type": "array"
    },
    "supersedes_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Id"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "user_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "User Id",
      "type": "string"
    },
    "validity": {
      "$ref": "#/$defs/MemoryValidity",
      "default": "current"
    }
  },
  "required": [
    "id",
    "user_id",
    "created_at",
    "updated_at",
    "kind",
    "content",
    "effective_at",
    "content_hash"
  ],
  "title": "Memory",
  "type": "object",
  "x-contract-version": 1
}
