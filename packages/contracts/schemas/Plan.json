{
  "$defs": {
    "AdapterMode": {
      "description": "Visible in every job result. A fixture must never claim production.",
      "enum": [
        "fixture",
        "local",
        "cloud"
      ],
      "title": "AdapterMode",
      "type": "string"
    },
    "Estimate": {
      "additionalProperties": false,
      "description": "A duration estimate that always declares where it came from.",
      "properties": {
        "minutes": {
          "maximum": 1440,
          "minimum": 0,
          "title": "Minutes",
          "type": "integer"
        },
        "minutes_max": {
          "anyOf": [
            {
              "maximum": 1440,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minutes Max"
        },
        "provenance": {
          "enum": [
            "user",
            "inferred",
            "default"
          ],
          "title": "Provenance",
          "type": "string"
        }
      },
      "required": [
        "minutes",
        "provenance"
      ],
      "title": "Estimate",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "One retrieved, source-backed justification shown to the user.",
      "properties": {
        "excerpt": {
          "maxLength": 2000,
          "title": "Excerpt",
          "type": "string"
        },
        "memory_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Id"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "source_id": {
          "maxLength": 128,
          "minLength": 3,
          "title": "Source Id",
          "type": "string"
        },
        "source_version": {
          "minimum": 1,
          "title": "Source Version",
          "type": "integer"
        },
        "span_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Ref"
        },
        "validity": {
          "default": "current",
          "enum": [
            "current",
            "historical",
            "superseded",
            "uncertain"
          ],
          "title": "Validity",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_version",
        "excerpt",
        "recorded_at"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "PlanBlock": {
      "additionalProperties": false,
      "properties": {
        "completion_criterion": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completion Criterion"
        },
        "ends_at": {
          "format": "date-time",
          "title": "Ends At",
          "type": "string"
        },
        "estimate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Estimate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "event_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Id"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "fixed": {
          "default": false,
          "title": "Fixed",
          "type": "boolean"
        },
        "next_steps": {
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "title": "Next Steps",
          "type": "array"
        },
        "pinned": {
          "default": false,
          "title": "Pinned",
          "type": "boolean"
        },
        "rationale": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "starts_at": {
          "format": "date-time",
          "title": "Starts At",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "starts_at",
        "ends_at",
        "title"
      ],
      "title": "PlanBlock",
      "type": "object"
    },
    "PlanStatus": {
      "enum": [
        "pending",
        "generating",
        "proposed",
        "accepted",
        "invalidated",
        "failed",
        "fallback"
      ],
      "title": "PlanStatus",
      "type": "string"
    },
    "PlanValidation": {
      "additionalProperties": false,
      "description": "Produced by application code. The model cannot mark its own plan valid.",
      "properties": {
        "capacity_minutes": {
          "minimum": 0,
          "title": "Capacity Minutes",
          "type": "integer"
        },
        "checked_by": {
          "const": "application",
          "default": "application",
          "title": "Checked By",
          "type": "string"
        },
        "inputs_complete": {
          "default": true,
          "title": "Inputs Complete",
          "type": "boolean"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/ValidationIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "scheduled_minutes": {
          "minimum": 0,
          "title": "Scheduled Minutes",
          "type": "integer"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        }
      },
      "required": [
        "valid",
        "capacity_minutes",
        "scheduled_minutes"
      ],
      "title": "PlanValidation",
      "type": "object"
    },
    "ValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "block_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Index"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 500,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "default": "error",
          "enum": [
            "error",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ValidationIssue",
      "type": "object"
    }
  },
  "$id": "https://metis.local/schemas/v1/Plan.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accepted_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accepted At"
    },
    "adapter_mode": {
      "$ref": "#/$defs/AdapterMode",
      "default": "fixture"
    },
    "assumptions": {
      "items": {
        "maxLength": 500,
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "blocks": {
      "items": {
        "$ref": "#/$defs/PlanBlock"
      },
      "title": "Blocks",
      "type": "array"
    },
    "change_summary": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Change Summary"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Id",
      "type": "string"
    },
    "input_revisions": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Input Revisions",
      "type": "object"
    },
    "local_date": {
      "format": "date",
      "title": "Local Date",
      "type": "string"
    },
    "model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Id"
    },
    "overflow_task_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "type": "string"
      },
      "title": "Overflow Task Ids",
      "type": "array"
    },
    "planning_epoch": {
      "minimum": 0,
      "title": "Planning Epoch",
      "type": "integer"
    },
    "prompt_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Version"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/PlanStatus",
      "default": "pending"
    },
    "time_budget_minutes": {
      "minimum": 0,
      "title": "Time Budget Minutes",
      "type": "integer"
    },
    "timezone": {
      "examples": [
        "America/New_York"
      ],
      "maxLength": 64,
      "minLength": 1,
      "title": "Timezone",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "user_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "User Id",
      "type": "string"
    },
    "validation": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlanValidation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "user_id",
    "created_at",
    "updated_at",
    "local_date",
    "timezone",
    "planning_epoch",
    "time_budget_minutes"
  ],
  "title": "Plan",
  "type": "object",
  "x-contract-version": 1
}
