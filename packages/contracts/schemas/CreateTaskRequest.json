{
  "$defs": {
    "Estimate": {
      "additionalProperties": false,
      "description": "A duration estimate that always declares where it came from.",
      "properties": {
        "minutes": {
          "maximum": 1440,
          "minimum": 0,
          "title": "Minutes",
          "type": "integer"
        },
        "minutes_max": {
          "anyOf": [
            {
              "maximum": 1440,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minutes Max"
        },
        "provenance": {
          "enum": [
            "user",
            "inferred",
            "default"
          ],
          "title": "Provenance",
          "type": "string"
        }
      },
      "required": [
        "minutes",
        "provenance"
      ],
      "title": "Estimate",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "Pointer to an immutable source revision, optionally a span within it.",
      "properties": {
        "source_id": {
          "maxLength": 128,
          "minLength": 3,
          "title": "Source Id",
          "type": "string"
        },
        "source_version": {
          "minimum": 1,
          "title": "Source Version",
          "type": "integer"
        },
        "span_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Ref"
        }
      },
      "required": [
        "source_id",
        "source_version"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "TaskState": {
      "enum": [
        "inbox",
        "ready",
        "in_progress",
        "blocked",
        "done",
        "canceled"
      ],
      "title": "TaskState",
      "type": "string"
    }
  },
  "$id": "https://metis.local/schemas/v1/CreateTaskRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "body": {
      "anyOf": [
        {
          "maxLength": 20000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Body"
    },
    "deadline_local_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deadline Local Date"
    },
    "duration_estimate": {
      "anyOf": [
        {
          "$ref": "#/$defs/Estimate"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "priority": {
      "default": 1,
      "maximum": 3,
      "minimum": 0,
      "title": "Priority",
      "type": "integer"
    },
    "project_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "source_refs": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "title": "Source Refs",
      "type": "array"
    },
    "state": {
      "$ref": "#/$defs/TaskState",
      "default": "inbox"
    },
    "timezone": {
      "anyOf": [
        {
          "examples": [
            "America/New_York"
          ],
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Timezone"
    },
    "title": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "title": "CreateTaskRequest",
  "type": "object",
  "x-contract-version": 1
}
