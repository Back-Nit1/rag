{
  "_note": "Synthetic retrieval evaluation set. Development and held-out questions are split so retrieval settings are not tuned on the evaluation half. Hybrid retrieval and reranking are experiments gated on these numbers, not architectural requirements.",
  "metrics": [
    "recall_at_k",
    "useful_top_result",
    "stale_evidence_admitted",
    "source_link_valid",
    "cross_user_leakage",
    "downstream_plan_defects",
    "latency_ms",
    "cost_micro_usd"
  ],
  "report_rule": "Fix the generator settings and the final evidence budget across arms, and report retrieval/reranking cost and latency so added computation is visible.",
  "questions": [
    {"id": "q01", "split": "dev", "category": "paraphrase", "question": "what went wrong with caching the review files", "expect_memory_kinds": ["attempt", "work_log"], "expect_source_ids": ["src_demo_cerno"]},
    {"id": "q02", "split": "dev", "category": "paraphrase", "question": "why does the review keep reading the same files", "expect_source_ids": ["src_demo_cerno"]},
    {"id": "q03", "split": "dev", "category": "exact_identifier", "question": "Cerno", "expect_projects": ["proj_cerno"]},
    {"id": "q04", "split": "dev", "category": "exact_identifier", "question": "CRN-1", "expect_projects": ["proj_cerno"]},
    {"id": "q05", "split": "dev", "category": "project_lookup", "question": "where did I leave off on Cerno", "expect_source_ids": ["src_demo_cerno"]},
    {"id": "q06", "split": "dev", "category": "time_lookup", "question": "what is due this week", "expect_structured": true, "note": "must come from the authoritative store, never from similarity"},
    {"id": "q07", "split": "dev", "category": "obsolete_decision", "question": "are we using Kafka", "expect_validity": "superseded", "note": "the abandoned decision must be retrievable AND labelled"},
    {"id": "q08", "split": "dev", "category": "ambiguous_reference", "question": "that caching approach", "expect_clarification": true},
    {"id": "q09", "split": "dev", "category": "missing_memory", "question": "what did I decide about the Lisbon trip", "expect_empty": true, "note": "an empty result must not be padded with invented detail"},
    {"id": "q10", "split": "dev", "category": "changed_commitment", "question": "when is the application due", "expect_structured": true, "note": "the revised deadline wins over the original note"},
    {"id": "q11", "split": "dev", "category": "negation", "question": "which approaches did I rule out", "expect_memory_kinds": ["attempt", "decision"]},
    {"id": "q12", "split": "dev", "category": "cross_user", "question": "caching whole files went stale", "expect_cross_user_leakage": 0},
    {"id": "q13", "split": "dev", "category": "paraphrase", "question": "the New York finance event I wanted to attend", "expect_source_ids": ["src_demo_bloomberg"]},
    {"id": "q14", "split": "dev", "category": "exact_identifier", "question": "Themis", "expect_projects": ["proj_themis"]},
    {"id": "q15", "split": "dev", "category": "project_lookup", "question": "open questions on Themis", "expect_projects": ["proj_themis"]},
    {"id": "q16", "split": "dev", "category": "time_lookup", "question": "what is overdue", "expect_structured": true},
    {"id": "q17", "split": "dev", "category": "obsolete_decision", "question": "do we still cache whole files", "expect_validity": "superseded"},
    {"id": "q18", "split": "dev", "category": "ambiguous_reference", "question": "the thing I tried last week", "expect_clarification": true},
    {"id": "q19", "split": "dev", "category": "missing_memory", "question": "my notes on the tax filing", "expect_empty": true},
    {"id": "q20", "split": "dev", "category": "changed_commitment", "question": "am I registered for the event", "expect_structured": true},

    {"id": "q21", "split": "heldout", "category": "paraphrase", "question": "the invalidation idea for stale cache entries", "expect_source_ids": ["src_demo_cerno"]},
    {"id": "q22", "split": "heldout", "category": "paraphrase", "question": "what should I prepare before the event", "expect_source_ids": ["src_demo_bloomberg"]},
    {"id": "q23", "split": "heldout", "category": "exact_identifier", "question": "cerno-review", "expect_projects": ["proj_cerno"]},
    {"id": "q24", "split": "heldout", "category": "exact_identifier", "question": "ERR_CACHE_STALE", "expect_empty": true},
    {"id": "q25", "split": "heldout", "category": "project_lookup", "question": "latest blocker on Cerno", "expect_memory_kinds": ["blocker", "attempt"]},
    {"id": "q26", "split": "heldout", "category": "time_lookup", "question": "what is on for the eighth", "expect_structured": true},
    {"id": "q27", "split": "heldout", "category": "obsolete_decision", "question": "did I abandon anything on Cerno", "expect_memory_kinds": ["attempt"]},
    {"id": "q28", "split": "heldout", "category": "ambiguous_reference", "question": "that workshop", "expect_clarification": true},
    {"id": "q29", "split": "heldout", "category": "missing_memory", "question": "the conversation about moving apartments", "expect_empty": true},
    {"id": "q30", "split": "heldout", "category": "changed_commitment", "question": "is the twelfth still the deadline", "expect_structured": true},
    {"id": "q31", "split": "heldout", "category": "negation", "question": "what did I say I would not do", "expect_memory_kinds": ["decision", "attempt"]},
    {"id": "q32", "split": "heldout", "category": "cross_user", "question": "diff-aware invalidation", "expect_cross_user_leakage": 0},
    {"id": "q33", "split": "heldout", "category": "paraphrase", "question": "forty minutes of focused work tomorrow", "expect_source_ids": ["src_demo_cerno"]},
    {"id": "q34", "split": "heldout", "category": "project_lookup", "question": "Cerno next action", "expect_memory_kinds": ["work_log", "attempt"]},
    {"id": "q35", "split": "heldout", "category": "time_lookup", "question": "anything tentative I have not committed to", "expect_structured": true},
    {"id": "q36", "split": "heldout", "category": "obsolete_decision", "question": "the superseded registration reminder", "expect_structured": true},
    {"id": "q37", "split": "heldout", "category": "ambiguous_reference", "question": "it broke again", "expect_clarification": true},
    {"id": "q38", "split": "heldout", "category": "missing_memory", "question": "notes from the dentist", "expect_empty": true},
    {"id": "q39", "split": "heldout", "category": "changed_commitment", "question": "did I cancel the event", "expect_structured": true},
    {"id": "q40", "split": "heldout", "category": "exact_identifier", "question": "proj_cerno", "expect_projects": ["proj_cerno"]}
  ]
}
