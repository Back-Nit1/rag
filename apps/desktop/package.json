{
  "name": "@metis/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Metis desktop shell (Tauri v2) - loads the apps/web build",
  "type": "module",
  "scripts": {
    "sidecar:prepare": "sh scripts/prepare-sidecar.sh",
    "tauri": "pnpm sidecar:prepare && tauri",
    "fmt": "cargo fmt --all",
    "fmt:check": "cargo fmt --all --check",
    "lint": "pnpm sidecar:prepare && cargo clippy --workspace --all-targets -- -D warnings",
    "typecheck": "pnpm sidecar:prepare && cargo check --workspace --all-targets",
    "test": "pnpm sidecar:prepare && cargo test --workspace"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1"
  }
}
