# Metis environment template. Copy to .env for local development.
# No third-party AI provider key is required in local mode.

# ---- mode -------------------------------------------------------------------
# local  = SQLite + filesystem objects + fixture ASR + fixture inference
# hybrid = local state, real Bedrock + real ASR container
# cloud  = DynamoDB + S3 + Bedrock + ECS ASR + EventBridge Scheduler
METIS_MODE=local
METIS_ENV=dev
METIS_LOG_LEVEL=INFO
METIS_DEFAULT_TIMEZONE=America/New_York
METIS_CORS_ORIGINS=http://localhost:5173

# Fixture identity is a development convenience. Deployment checks reject it
# for METIS_ENV=prod; production uses the Cognito authorizer instead.
METIS_ALLOW_FIXTURE_IDENTITY=true
METIS_FIXTURE_USER_ID=demo_authenticated_subject

METIS_SQLITE_PATH=.metis/metis.sqlite
METIS_LOCAL_OBJECTS_DIR=.metis/objects

# ---- limits (all enforced server-side) --------------------------------------
METIS_MAX_AUDIO_SECONDS=300
METIS_MAX_UPLOAD_BYTES=26214400
METIS_EXTRACT_IN_TOKENS=4000
METIS_EXTRACT_OUT_TOKENS=1200
METIS_PLAN_IN_TOKENS=8000
METIS_PLAN_OUT_TOKENS=2000
METIS_PLAN_CANDIDATES=8
METIS_PLAN_TOOL_ITERS=4
METIS_RETRIEVAL_CANDIDATES=20
METIS_EVIDENCE_PER_TASK=6
METIS_SPEECH_CONCURRENCY=1
METIS_JOB_MAX_ATTEMPTS=5

# ---- budgets (micro-USD; 1_000_000 = $1.00) ---------------------------------
METIS_DAILY_MICRO_USD=500000
METIS_MONTHLY_MICRO_USD=10000000

# ---- models (verify ids and prices against the region's rate card) ----------
METIS_EXTRACTION_MODEL_ID=amazon.nova-micro-v1:0
METIS_PLANNING_MODEL_ID=amazon.nova-lite-v1:0
METIS_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
METIS_EMBEDDING_DIMENSIONS=512
METIS_ALLOW_ESCALATION=false
METIS_INPUT_MICRO_USD_PER_1K=35
METIS_OUTPUT_MICRO_USD_PER_1K=140

# ---- owned speech-to-text ---------------------------------------------------
METIS_SPEECH_MODEL_ID=small.en
METIS_SPEECH_MODEL_DIR=/opt/models
METIS_SPEECH_ARTIFACT_REVISION=unpinned
METIS_SPEECH_COMPUTE_TYPE=int8
METIS_SPEECH_BEAM_SIZE=1
METIS_SPEECH_VAD=true
METIS_SPEECH_LANGUAGE=en

# ---- AWS (cloud / hybrid mode only; credentials come from a profile or role)
AWS_REGION=us-east-1
# METIS_TABLE_NAME=
# METIS_SOURCES_BUCKET=
# METIS_VECTOR_BUCKET=
# METIS_VECTOR_INDEX=
# METIS_INGEST_QUEUE_URL=
# METIS_SCHEDULER_GROUP=
# METIS_SCHEDULER_ROLE_ARN=
# METIS_REMINDER_TARGET_ARN=
# METIS_SPEECH_STATE_MACHINE_ARN=
# METIS_COGNITO_USER_POOL_ID=
# METIS_COGNITO_CLIENT_ID=
# Web push uses standard VAPID signing — a generated key pair, not a paid SaaS.
# METIS_VAPID_PUBLIC_KEY=
# METIS_VAPID_PRIVATE_KEY_PARAM=/metis/dev/vapid-private-key
